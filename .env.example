# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Better Auth client configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-here

# Mock auth — set to "true" for local development without a backend
# Provides 3 users: admin@example.com, operador@example.com, lector@example.com
# Password for all: admin123, operador123, lector123 respectively
NEXT_PUBLIC_MOCK_AUTH=false
